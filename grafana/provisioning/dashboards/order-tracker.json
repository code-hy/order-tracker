{
  "uid": "order-tracker-requests",
  "title": "Order Tracker requests",
  "tags": ["order-tracker", "homework4"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Request rate by route and status",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (http_route, http_response_status_code) (rate(http_server_requests_total[5m]))",
          "legendFormat": "{{http_route}} {{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Server errors (5xx rate)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum by (http_route) (rate(http_server_requests_total{http_response_status_code=~\"5..\"}[5m]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Total requests",
      "type": "stat",
      "gridPos": {"h": 4, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "prometheus"},
          "expr": "sum(http_server_requests_total)"
        }
      ]
    },
    {
      "id": 4,
      "title": "App logs",
      "type": "logs",
      "gridPos": {"h": 12, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "loki", "uid": "loki"},
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "loki", "uid": "loki"},
          "expr": "{service_name=\"order-tracker\"}"
        }
      ]
    }
  ]
}
